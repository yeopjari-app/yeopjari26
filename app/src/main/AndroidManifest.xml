<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 가족 알림(휴식 시작·재출발 두 번). 번호를 등록한 경우에만 쓴다 -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- 차량(Android Automotive)용 앱. 휴대전화·에뮬레이터에서도 설치되게 required=false -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- Android 11+ 에서 음성 인식·TTS 서비스를 찾기 위해 필요 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:keepScreenOn="true">
            <!-- 주행 중에도 화면이 가려지지 않게: 큰 글자·짧은 대답 위주로 만든 화면 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
